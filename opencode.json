{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "maltego": {
      "type": "local",
      "command": ["uv", "run", "--quiet", "maltego-mcp"],
      "cwd": ".",
      "enabled": true,
      "environment": {
        "MALTEGO_MCP_ALLOW_ACTIVE": "1",
        "MALTEGO_MCP_MODE": "active"
      }
    }
  }
}
