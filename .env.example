# Copia como ~/.maltego-mcp/.env (leído automáticamente por todos los agentes y por el puente de Maltego Desktop,
# fuera del repo) o define estas variables en tu sistema / bloque `env` del cliente MCP.
# Todas son opcionales: sin ellas funcionan los 51 transforms públicos que no necesitan API key (63 en total).
# Modo operativo por defecto (habilita transforms activos y pasivos no intrusivos con concurrencia controlada):
MALTEGO_MCP_ALLOW_ACTIVE=1
MALTEGO_MCP_MODE=active
# Proveedores con capa gratuita (Free Tier sin tarjeta de pago):
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
HUNTER_API_KEY=
GREYNOISE_API_KEY=
TATUM_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
URLHAUS_API_KEY=
GITHUB_TOKEN=
# Proveedores opcionales (requieren cuenta v2 o suscripción):
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
# MALTEGO_MCP_HOME=~/.maltego-mcp
# Anillo de egreso Mullvad (obligatorio por defecto; ver docs/USO.md). Sin credenciales: el proxy interno del túnel
# no las necesita y el número de cuenta de Mullvad nunca se configura aquí.
# MALTEGO_MCP_REQUIRE_MULLVAD=1
# MALTEGO_MCP_MULLVAD_SOCKS=socks5h://10.64.0.1:1080
# MALTEGO_MCP_MULLVAD_ATTEST_TTL=30
# MALTEGO_MCP_MULLVAD_REMOTE_CHECK=1
# MALTEGO_MCP_MULLVAD_ISOLATION=off
# Autenticación del panel web local (PBKDF2-HMAC-SHA256 con sal, sin contraseña en texto claro):
# MALTEGO_MCP_DASHBOARD_AUTH=1
# MALTEGO_MCP_DASHBOARD_USER=admin
# MALTEGO_MCP_DASHBOARD_PASSWORD_HASH=
