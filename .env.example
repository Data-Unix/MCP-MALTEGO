# Copia como ~/.maltego-mcp/.env (leído automáticamente por todos los agentes y por el puente de Maltego Desktop,
# fuera del repo) o define estas variables en tu sistema / bloque `env` del cliente MCP.
# Todas son opcionales: sin ellas funcionan los 18 transforms públicos que no necesitan API key.
# Proveedores con capa gratuita (Free Tier sin tarjeta de pago):
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
HUNTER_API_KEY=
GREYNOISE_API_KEY=
TATUM_API_KEY=
# Proveedores opcionales (requieren cuenta v2 o suscripción):
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
# MALTEGO_MCP_HOME=~/.maltego-mcp
